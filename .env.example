# Configuración local de ejemplo. Copiar como .env antes de ejecutar.
POSTGRES_USER=tp_user
POSTGRES_PASSWORD=password
POSTGRES_DB=tp_db
DB_PORT=5432
DATABASE_URL=postgres://tp_user:password@localhost:5432/tp_db?sslmode=disable
HTTP_ADDR=:8080

# Las pruebas usan otro proyecto Docker y estos puertos.
TEST_DB_PORT=55432
TEST_HTTP_PORT=18080
